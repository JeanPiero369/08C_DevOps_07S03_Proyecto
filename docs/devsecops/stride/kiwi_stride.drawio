        <mxCell id="kiwi-plantilla-v36" value="Orchestrator → ms-quiz (generate-from-pdf) y cuota de Gemini" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="385" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v37" value="/teacher/quiz/generate-from-pdf no limita tamaño ni frecuencia: el PDF se lee completo en memoria y cada petición consume cuota de Gemini. Una ráfaga de PDFs grandes tumba el EC2 compartido." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">

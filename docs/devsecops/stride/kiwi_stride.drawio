          <mxGeometry x="384" y="1234" width="160" height="42" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v140" value="Permitir que alguien haga algo para lo que no está autorizado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=12;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="544" y="1234" width="400" height="42" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v141" value="Catálogo de amenazas identificadas" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="975" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v142" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1010" width="52" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v143" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1010" width="44" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v144" value="&lt;b&gt;Componente / flujo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1010" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v145" value="&lt;b&gt;Amenaza&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1010" width="684" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v146" value="&lt;b&gt;T1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1040" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v147" value="S" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1040" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v148" value="Navegador · sesión JWT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1040" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v149" value="Robo del JWT guardado en &lt;i&gt;localStorage&lt;/i&gt; (vía XSS o equipo compartido) y reutilización para suplantar a un docente o estudiante; el token dura 24 h y no se puede revocar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1040" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v150" value="&lt;b&gt;T2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1080" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v151" value="T" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1080" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v152" value="Flujo navegador ↔ orchestrator" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1080" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v153" value="El orchestrator se publica con uvicorn en HTTP (:8000) y el compose no incluye terminación TLS: un atacante en la red (MITM) puede alterar respuestas, notas o envíos de quiz." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1080" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v154" value="&lt;b&gt;T3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1120" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v155" value="R" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1120" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v156" value="Desarrollador → GitHub" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1120" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v157" value="Un desarrollador introduce código malicioso y niega su autoría: los commits locales no están firmados y no hay revisión obligatoria verificable antes del despliegue." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1120" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v158" value="&lt;b&gt;T4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1160" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v159" value="I" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1160" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v160" value="Secretos (.env en el host EC2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1160" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v161" value="JWT_SECRET, GOOGLE_API_KEY, MAIL_PASSWORD y DB_PASSWORD se inyectan como variables de entorno en texto plano (solo PostgreSQL usa Docker secrets). Con JWT_SECRET se pueden forjar tokens de cualquier usuario." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1160" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v162" value="&lt;b&gt;T5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1200" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v163" value="D" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1200" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v164" value="Orchestrator → ms-quiz (PDF)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1200" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v165" value="/teacher/quiz/generate-from-pdf no limita tamaño ni frecuencia: el PDF se lee completo en memoria y cada petición consume cuota de Gemini. Una ráfaga de PDFs grandes tumba el EC2 compartido." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1200" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v166" value="&lt;b&gt;T6&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1240" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v167" value="E" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1240" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v168" value="ms-user · /auth/register" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1240" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v169" value="El rol (STUDENT / TEACHER) lo envía el propio cliente al registrarse: cualquiera puede crearse una cuenta TEACHER y crear aulas, quizzes y ver resultados de alumnos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1240" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v170" value="&lt;b&gt;T7&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1280" width="52" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v171" value="S" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1280" width="44" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v172" value="Estudiante / Docente" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1280" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v173" value="Phishing o fuerza bruta de credenciales: el login no tiene MFA, bloqueo por intentos ni rate limiting." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1280" width="684" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v174" value="&lt;b&gt;T8&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1306" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v175" value="T" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1306" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v176" value="Pipeline GitHub → Amplify" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1306" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v177" value="Una dependencia npm comprometida o un cambio no revisado alteran el bundle que Amplify publica a todos los usuarios (cadena de suministro)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1306" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v178" value="&lt;b&gt;T9&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1346" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v179" value="I" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1346" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v180" value="Orchestrator" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1346" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v181" value="Swagger (/docs) público y CORS allow_origins=&quot;*&quot; exponen la superficie completa de la API y permiten invocarla desde cualquier sitio." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1346" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v182" value="&lt;b&gt;T10&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1386" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v183" value="R" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1386" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v184" value="Orchestrator / ms-classroom" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1386" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v185" value="No hay logs de auditoría con la identidad del usuario: un estudiante puede negar un envío de quiz o un docente un cambio de notas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1386" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v186" value="&lt;b&gt;T11&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1426" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v187" value="S" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1426" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v188" value="ms-classroom" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1426" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v189" value="No autentica a quien lo llama: un contenedor comprometido en la red backend puede invocarlo haciéndose pasar por el orchestrator." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1426" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v190" value="&lt;b&gt;T12&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1466" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v191" value="T" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1466" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v192" value="ms-quiz → Gemini" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1466" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v193" value="Prompt injection dentro del PDF o texto subido manipula las preguntas o las respuestas correctas que genera la IA." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1466" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v194" value="&lt;b&gt;T13&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1506" width="52" height="26" as="geometry" />

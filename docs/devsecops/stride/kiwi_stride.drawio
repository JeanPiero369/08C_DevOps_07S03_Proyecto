        <mxCell id="kiwi-stride-v195" value="I" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1506" width="44" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v196" value="ms-quiz → Gemini" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1506" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v197" value="El contenido de los PDFs (posibles datos de alumnos) se envía a un tercero (Google) sin anonimizar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1506" width="684" height="26" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v198" value="&lt;b&gt;T14&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1532" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v199" value="S" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1532" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v200" value="ms-user → Gmail SMTP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1532" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v201" value="Los correos salen de una cuenta Gmail genérica, sin dominio propio con SPF/DKIM/DMARC: es fácil imitar correos de Kiwi para phishing." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1532" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v202" value="&lt;b&gt;T15&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1572" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v203" value="I" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1572" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v204" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1572" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v205" value="Los tres microservicios usan el mismo usuario de BD y el volumen no tiene cifrado configurado: comprometer un servicio expone los datos de todos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1572" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v206" value="&lt;b&gt;T16&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1612" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v207" value="T" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1612" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v208" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1612" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v209" value="Con el usuario de BD compartido, un servicio comprometido puede modificar tablas de otros esquemas (usuarios, notas, monedas)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1612" width="684" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v210" value="&lt;b&gt;T17&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="980" y="1652" width="52" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v211" value="E" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;align=center;fontStyle=1;fontColor=#00B0F0;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1032" y="1652" width="44" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v212" value="Orchestrator (IDOR)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1076" y="1652" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-stride-v213" value="Solo se valida el rol del token, no que teacher_id / userId de la URL o del body sean del usuario: p. ej. comprar personajes con monedas de otro en /characters/buy." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-stride-1">
          <mxGeometry x="1276" y="1652" width="684" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Plantilla de amenazas" id="kiwi-plantilla">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="kiwi-plantilla-0" />
        <mxCell id="kiwi-plantilla-1" parent="kiwi-plantilla-0" />
        <mxCell id="kiwi-plantilla-v1" value="3) Plantilla de amenazas priorizadas (formato STRIDE_Plantilla.xlsx)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="10" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v2" value="Riesgo inherente según la hoja «2) Evaluación de Riesgos» + «Risk Scale»; riesgo residual según «Controls Scale». Apetito de riesgo (Config!A10): &lt;b&gt;3 - Moderate&lt;/b&gt; → «Is Mitigated» = Yes solo si el riesgo residual es menor que el apetito." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3e4c59;whiteSpace=wrap;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="48" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v3" value="Amenazas y riesgo inherente" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="100" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v4" value="&lt;b&gt;Threat Id&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#8DB3E2;fontColor=#000000;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="135" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v5" value="&lt;b&gt;Threat Type&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="110" y="135" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v6" value="&lt;b&gt;Component&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="135" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v7" value="&lt;b&gt;Description&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="560" y="135" width="470" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v8" value="&lt;b&gt;Risk Template&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#000000;fontColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1030" y="135" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v9" value="&lt;b&gt;Inherent Risk&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;verticalAlign=middle;fillColor=#366092;fontColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1370" y="135" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v10" value="&lt;b&gt;T1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="165" width="70" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v11" value="1- Spoofing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#E2F0D9;fontSize=13;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="110" y="165" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v12" value="Sesión JWT en el navegador (localStorage)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="165" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v13" value="Robo del JWT guardado en &lt;i&gt;localStorage&lt;/i&gt; (vía XSS o equipo compartido) y reutilización para suplantar a un docente o estudiante; el token dura 24 h y no se puede revocar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="560" y="165" width="470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v14" value="1- Spoofing - Ejecución desde origen externo (fuera de la organización)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1030" y="165" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v15" value="4 - High" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FFC000;fontColor=#000000;fontStyle=1;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1370" y="165" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v16" value="&lt;b&gt;T2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="220" width="70" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v17" value="2- Tampering" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FFF2CC;fontSize=13;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="110" y="220" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v18" value="Flujo navegador ↔ orchestrator (HTTP :8000)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="220" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v19" value="El orchestrator se publica con uvicorn en HTTP (:8000) y el compose no incluye terminación TLS: un atacante en la red (MITM) puede alterar respuestas, notas o envíos de quiz." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="560" y="220" width="470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v20" value="2- Tampering - Manipulación de flujos de datos desde/hacia el entorno" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1030" y="220" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v21" value="3 - Moderate" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FFFF00;fontColor=#000000;fontStyle=1;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1370" y="220" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v22" value="&lt;b&gt;T3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="275" width="70" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v23" value="3- Repudation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FCE4E4;fontSize=13;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="110" y="275" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v24" value="Desarrollador → repositorio GitHub" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="275" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v25" value="Un desarrollador introduce código malicioso y niega su autoría: los commits locales no están firmados y no hay revisión obligatoria verificable antes del despliegue." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="560" y="275" width="470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v26" value="3- Repudation - Desarrollador inserta código malicioso en servicio externo sin trazabilidad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1030" y="275" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v27" value="4 - High" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FFC000;fontColor=#000000;fontStyle=1;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1370" y="275" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v28" value="&lt;b&gt;T4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="40" y="330" width="70" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v29" value="4 - Information Disclosure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#EDE7F6;fontSize=13;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="110" y="330" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v30" value="Secretos del stack (.env en el host EC2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="330" y="330" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v31" value="JWT_SECRET, GOOGLE_API_KEY, MAIL_PASSWORD y DB_PASSWORD se inyectan como variables de entorno en texto plano (solo PostgreSQL usa Docker secrets). Con JWT_SECRET se pueden forjar tokens de cualquier usuario." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="560" y="330" width="470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v32" value="4 - Information Disclosure - Exposición de secretos en repositorio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1030" y="330" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="kiwi-plantilla-v33" value="4 - High" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=4;fontSize=11;strokeColor=#000000;fontSize=11;fillColor=#ffffff;fillColor=#FFC000;fontColor=#000000;fontStyle=1;" vertex="1" parent="kiwi-plantilla-1">
          <mxGeometry x="1370" y="330" width="110" height="55" as="geometry" />
        </mxCell>
